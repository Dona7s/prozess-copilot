<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Prozess Copilot" exporterVersion="0.1">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Bestellabwicklung" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" name="Bestellabwicklung" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="lane_customer" name="Kunde">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_order</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_sales" name="Vertrieb">
        <bpmn:flowNodeRef>task_check_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>gw_in_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>task_notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_notified</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_warehouse" name="Lager">
        <bpmn:flowNodeRef>task_ship</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_shipped</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Bedarf entstanden">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="task_order" name="Bestellung aufgeben">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_check_stock" name="Lagerbestand prüfen">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_in_stock" name="Ware vorrätig?">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
      <bpmn:outgoing>f5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="task_ship" name="Ware versenden">
      <bpmn:incoming>f4</bpmn:incoming>
      <bpmn:outgoing>f6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="task_notify" name="Kunden benachrichtigen">
      <bpmn:incoming>f5</bpmn:incoming>
      <bpmn:outgoing>f7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="end_shipped" name="Bestellung versendet">
      <bpmn:incoming>f6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="end_notified" name="Kunde informiert">
      <bpmn:incoming>f7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="start" targetRef="task_order" />
    <bpmn:sequenceFlow id="f2" sourceRef="task_order" targetRef="task_check_stock" />
    <bpmn:sequenceFlow id="f3" sourceRef="task_check_stock" targetRef="gw_in_stock" />
    <bpmn:sequenceFlow id="f4" sourceRef="gw_in_stock" targetRef="task_ship" name="Ja" />
    <bpmn:sequenceFlow id="f5" sourceRef="gw_in_stock" targetRef="task_notify" name="Nein" />
    <bpmn:sequenceFlow id="f6" sourceRef="task_ship" targetRef="end_shipped" />
    <bpmn:sequenceFlow id="f7" sourceRef="task_notify" targetRef="end_notified" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="1150" height="390" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_customer_di" bpmnElement="lane_customer" isHorizontal="true">
        <dc:Bounds x="70" y="40" width="1120" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_sales_di" bpmnElement="lane_sales" isHorizontal="true">
        <dc:Bounds x="70" y="170" width="1120" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="lane_warehouse_di" bpmnElement="lane_warehouse" isHorizontal="true">
        <dc:Bounds x="70" y="300" width="1120" height="130" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_di" bpmnElement="start">
        <dc:Bounds x="152" y="87" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_order_di" bpmnElement="task_order">
        <dc:Bounds x="285" y="65" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_check_stock_di" bpmnElement="task_check_stock">
        <dc:Bounds x="455" y="195" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="gw_in_stock_di" bpmnElement="gw_in_stock" isMarkerVisible="true">
        <dc:Bounds x="655" y="210" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="630" y="180" width="100" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_ship_di" bpmnElement="task_ship">
        <dc:Bounds x="795" y="325" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="task_notify_di" bpmnElement="task_notify">
        <dc:Bounds x="795" y="195" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_shipped_di" bpmnElement="end_shipped">
        <dc:Bounds x="1002" y="347" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_notified_di" bpmnElement="end_notified">
        <dc:Bounds x="1002" y="217" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="188" y="105" />
        <di:waypoint x="285" y="105" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="340" y="145" />
        <di:waypoint x="340" y="235" />
        <di:waypoint x="455" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f3_di" bpmnElement="f3">
        <di:waypoint x="565" y="235" />
        <di:waypoint x="655" y="235" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f4_di" bpmnElement="f4">
        <di:waypoint x="680" y="260" />
        <di:waypoint x="680" y="365" />
        <di:waypoint x="795" y="365" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="690" y="345" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f5_di" bpmnElement="f5">
        <di:waypoint x="705" y="235" />
        <di:waypoint x="795" y="235" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="713" y="215" width="60" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f6_di" bpmnElement="f6">
        <di:waypoint x="905" y="365" />
        <di:waypoint x="1002" y="365" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f7_di" bpmnElement="f7">
        <di:waypoint x="905" y="235" />
        <di:waypoint x="1002" y="235" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>